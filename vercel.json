{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "env": {
        "APP_NAME": "Toko Online Khas Jogja",
        "APP_ENV": "production",
        "APP_DEBUG": "false"
    },
    "builds": [
        {
            "src": "api/index.php",
            "use": "@vercel/php"
        },
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "public"
            }
        }
    ],
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/build/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}